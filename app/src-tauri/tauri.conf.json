{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodehub",
  "version": "0.1.0",
  "identifier": "dev.kodehub.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kodehub — mission control",
        "width": 1600,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#090c13",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7878 ws://127.0.0.1:7878 http://localhost:7878 ws://localhost:7878; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
